# Caminho do .env existente no ClickDados (não copie credenciais para o projeto).
# Windows: use barras normais / ou barras invertidas \\.
# A v2.0.1 também localiza automaticamente pastas conhecidas do ClickDados.
# Se o banco não carregar, informe o caminho real e reinicie o serviço.
CLICKDADOS_ENV_PATH=C:/Users/stefano.faria/Desktop/Projetos/gestao_clientes/backend/.env

# Se preferir, configure DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD,
# DB_CHARSET, DB_SSL e DB_SSL_CA diretamente neste arquivo.

# Painel sem autenticação: mantenha acessível somente neste computador.
# Não altere APP_HOST para 0.0.0.0 sem implantar controle de acesso externo.
APP_HOST=127.0.0.1
APP_PORT=8515
TZ=America/Sao_Paulo

# SMTP: para Gmail use smtp.gmail.com:587 e uma senha de app;
# para Microsoft 365 use o servidor SMTP autorizado pela empresa.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_USE_SSL=false
SMTP_STARTTLS=true

# BLOQUEIO DE ENVIO: só são aceitos destinatários nestes domínios corporativos.
# Padrão: clickdigital.com.br. Acrescente outros APENAS se pertencerem à sua empresa.
# E-mails de clientes presentes na consulta nunca são destinatários de envio.
INTERNAL_EMAIL_DOMAINS=clickdigital.com.br

# Valores iniciais usados apenas na PRIMEIRA inicialização.
# Depois, alterar dias, ativação e destinatários em Configurações no painel.
# Destinatários iniciais de alerta, separados por vírgulas.
ALERT_EMAILS=stefano.faria@clickdigital.com.br
# Segurança: não dispara alertas sem ativação explícita.
ALERTS_ENABLED=false
ALERT_HOUR=8
ALERT_MINUTE=0

# Banco local pequeno para histórico e log de e-mails.
STATE_DB_PATH=data/monitor.sqlite3
# Cache de leitura do MySQL (segundos)
CACHE_SECONDS=300

# Opcional: URL HTTPS pública do painel acessível aos destinatários do e-mail;
# se vazia, os e-mails trazem a tabela e o CSV anexo (sem link para localhost).
PUBLIC_APP_URL=
